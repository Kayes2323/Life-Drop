rules_version = '2';

// ══════════════════════════════════════════════════════════════════
// Sondhan (life-drop-d4784) — Firebase Storage Security Rules
//
// এই ফাইলটা রিপোতে শুধু রেফারেন্স/হ্যান্ড-অফ — আসল rules শুধু Firebase
// Console (Storage → Rules) থেকেই publish করা যায়, তাই এই ফাইল না
// থাকলেও অ্যাপ কাজ করবে (শুধু Storage-ভিত্তিক ফিচার — Health File —
// বন্ধ থাকবে)। প্রয়োগ করতে হলে Console-এ Storage চালু করে (প্রথমবার
// হলে "Get started") এই পুরো কন্টেন্ট Rules ট্যাবে পেস্ট করে Publish
// করতে হবে।
//
// এই প্রজেক্টে Firebase Storage প্রথমবার ব্যবহার হচ্ছে (Health File
// ফিচারের জন্য)। আগের সব ছবি (প্রোফাইল/ফাউন্ডার) base64 আকারে সরাসরি
// Firestore-এ থাকে — এই rules তাদের স্পর্শ করে না।
//
// path: healthRecords/{uid}/{recordId}/{fileName}
//  • uid অংশটাই প্রকৃত সীমানা — Firestore ডকের ownerUid যা-ই বলুক না
//    কেন, এখানে path-এর uid request.auth.uid-এর সাথে না মিললে
//    কখনোই পড়া/লেখা যাবে না। তাই Health File-এর আসল গোপনীয়তা এই
//    ফাইলেই নিশ্চিত হয়, শুধু Firestore rules-এ নয়।
//  • সর্বোচ্চ ১৫ MB/ফাইল; শুধু ছবি বা PDF আপলোড হয়।
// ══════════════════════════════════════════════════════════════════

service firebase.storage {
  match /b/{bucket}/o {

    match /healthRecords/{uid}/{recordId}/{fileName} {
      allow read: if request.auth != null && request.auth.uid == uid;

      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.size <= 15 * 1024 * 1024
        && (request.resource.contentType.matches('image/.*')
            || request.resource.contentType == 'application/pdf');

      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    // বাকি সবকিছু ডিফল্টভাবে বন্ধ
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
