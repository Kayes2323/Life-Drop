rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ══════════════════════════════════════════════════════════
    // হেল্পার ফাংশন
    // ══════════════════════════════════════════════════════════
    function isLoggedIn() {
      return request.auth != null;
    }
    function isOwner(uid) {
      return isLoggedIn() && request.auth.uid == uid;
    }
    // ⚠️ client-side কোডের admin চেকের সাথে এটা হুবহু মিলতে হবে
    // (app.js এর isSuperAdmin() দেখুন)। একাধিক admin দরকার হলে
    // Firebase custom claims ব্যবহার করুন — hardcoded ইমেইল না বাড়িয়ে।
    function isAdmin() {
      return isLoggedIn() && request.auth.token.email == 'aakayes99@gmail.com';
    }
    function isValidBlood(b) {
      return b in ['A+','A-','B+','B-','AB+','AB-','O+','O-'];
    }

    // ══════════════════════════════════════════════════════════
    // DONORS — পাবলিক প্রোফাইল (phone/wa এখানে রাখা হয় না)
    // ══════════════════════════════════════════════════════════
    match /donors/{uid} {
      allow get  : if isLoggedIn();
      // BUGFIX: 'list' এখন limit(30) বাধ্যতামূলক করে — search.html
      // এখন সবসময় limit(30) সহ query পাঠায়। এর ফলে কেউ একটা কল দিয়ে
      // পুরো donors collection টেনে নিতে পারবে না।
      allow list : if isLoggedIn() && request.query.limit <= 30;

      allow create: if isOwner(uid)
        && request.resource.data.uid == uid
        && request.resource.data.name is string && request.resource.data.name.size() <= 100
        && isValidBlood(request.resource.data.blood)
        // নতুন donor নিজেকে fake rating/history দিয়ে শুরু করতে পারবে না
        && request.resource.data.donations == 0
        && request.resource.data.rating == 0
        && request.resource.data.raters == 0
        // phone/wa এই ডকুমেন্টে থাকা নিষেধ — donorsPrivate-এ যাবে
        && !('phone' in request.resource.data)
        && !('wa' in request.resource.data);

      // মালিক rating/raters ছাড়া বাকি সব বদলাতে পারে;
      // rating/raters শুধু validated community-rating আপডেটে বদলায়
      // (raters ঠিক ১ করে বাড়তে হবে — একবারে অনেক বাড়ানো যাবে না)
      allow update: if
        (isOwner(uid)
          && !request.resource.data.diff(resource.data).affectedKeys()
                .hasAny(['uid','rating','raters','createdAt'])
          && !('phone' in request.resource.data)
          && !('wa' in request.resource.data))
        ||
        (isLoggedIn()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['rating','raters'])
          && request.resource.data.rating is number
          && request.resource.data.rating >= 0 && request.resource.data.rating <= 5
          && request.resource.data.raters == resource.data.raters + 1);

      allow delete: if false;
    }

    // ══════════════════════════════════════════════════════════
    // DONORS PRIVATE — phone/wa। get-only, কখনো list নয়।
    // এটাই মূল phone-leak fix: bulk query করে কেউ এই collection
    // থেকে নম্বর সংগ্রহ করতে পারবে না, কারণ list সবসময় বন্ধ।
    // (single-uid দিয়ে একটার পর একটা loop করে scrape করা প্রযুক্তিগতভাবে
    //  সম্ভব থেকে যায় — সেটা পুরোপুরি বন্ধ করতে rate-limit/Cloud Function
    //  বা request-first ফ্লো লাগবে, যেটা future improvement হিসেবে
    //  রাখা হলো।)
    // ══════════════════════════════════════════════════════════
    match /donorsPrivate/{uid} {
      allow get   : if isLoggedIn();
      allow list  : if false;
      allow create: if isOwner(uid)
        && request.resource.data.phone is string
        && request.resource.data.phone.size() <= 20
        && request.resource.data.phone.size() >= 8;
      allow update: if isOwner(uid)
        && request.resource.data.phone is string
        && request.resource.data.phone.size() <= 20;
      allow delete: if false;
    }

    // ══════════════════════════════════════════════════════════
    // PHONE INDEX — শুধু ডুপ্লিকেট-ফোন ঠেকানোর জন্য (uid ছাড়া কিছু নেই)
    // ডকুমেন্ট আইডি = normalized ফোন নম্বর (+8801XXXXXXXXX)
    // একই নম্বর দিয়ে দ্বিতীয়বার create করতে গেলে rules নিজেই আটকাবে
    // (ডকুমেন্ট already exists → সেটা 'create' না 'update' হিসেবে গণ্য
    //  হবে, আর update এখানে সবসময় false)
    // ══════════════════════════════════════════════════════════
    match /phoneIndex/{phone} {
      allow get   : if isLoggedIn();
      allow list  : if false;
      allow create: if isLoggedIn() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }

    // ══════════════════════════════════════════════════════════
    // USERS
    // ══════════════════════════════════════════════════════════
    match /users/{uid} {
      allow read  : if isOwner(uid) || isAdmin();
      allow create: if isOwner(uid)
        && request.resource.data.name is string && request.resource.data.name.size() <= 100;
      // BUGFIX: আগে যেকোনো ফিল্ড বদলানো যেতো — ইউজার নিজেকে
      // isAdmin:true বানিয়ে দিতে পারতো। এখন সংবেদনশীল ফিল্ড immutable।
      allow update: if isOwner(uid)
        && !request.resource.data.diff(resource.data).affectedKeys()
              .hasAny(['uid','email','isAdmin','role','createdAt']);
      allow delete: if false;
    }

    // ══════════════════════════════════════════════════════════
    // BLOOD REQUESTS (request.html থেকে জরুরি পোস্ট)
    // ══════════════════════════════════════════════════════════
    match /bloodRequests/{docId} {
      allow read  : if isLoggedIn();
      // BUGFIX: আগে 'message' ফিল্ড চাওয়া হতো যা কোডে পাঠানোই হয় না
      // (আসল ফিল্ডের নাম 'details', এবং সেটা optional) — ফলে প্রতিটা
      // অনুরোধ সবসময় ব্যর্থ হতো। এখন কোডের সাথে হুবহু মিলিয়ে লেখা।
      allow create: if isLoggedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.patientName is string && request.resource.data.patientName.size() <= 100
        && request.resource.data.problem is string && request.resource.data.problem.size() <= 300
        && isValidBlood(request.resource.data.blood)
        && request.resource.data.bags is number
        && request.resource.data.bags >= 1 && request.resource.data.bags <= 20
        && request.resource.data.hospital is string && request.resource.data.hospital.size() <= 200
        && request.resource.data.location is string && request.resource.data.location.size() <= 200
        && request.resource.data.contactName is string && request.resource.data.contactName.size() <= 100
        && request.resource.data.contactPhone is string && request.resource.data.contactPhone.size() <= 20
        && (!('details' in request.resource.data) || request.resource.data.details.size() <= 500)
        && request.resource.data.status == 'active';
      allow update: if isLoggedIn() && isOwner(resource.data.uid);
      allow delete: if isLoggedIn() && isOwner(resource.data.uid);
    }

    // ══════════════════════════════════════════════════════════
    // REQUESTS (search.html থেকে "নির্দিষ্ট donor-কে অনুরোধ")
    // BUGFIX: আগে যেকোনো লগইন করা ইউজার সব অনুরোধ পড়তে/বদলাতে পারতো —
    // রোগীর তথ্য ও ফোন নম্বরসহ। এখন শুধু সংশ্লিষ্ট দুইজন (seeker ও donor)।
    // ══════════════════════════════════════════════════════════
    match /requests/{docId} {
      allow read  : if isLoggedIn() &&
        (request.auth.uid == resource.data.seekerUid || request.auth.uid == resource.data.donorId);
      allow create: if isLoggedIn()
        && request.resource.data.seekerUid == request.auth.uid
        && request.resource.data.donorId is string
        && request.resource.data.seekerName is string && request.resource.data.seekerName.size() <= 100
        && request.resource.data.seekerPhone is string && request.resource.data.seekerPhone.size() <= 20
        && request.resource.data.msg is string && request.resource.data.msg.size() <= 500
        && request.resource.data.status == 'pending';
      allow update: if isLoggedIn() &&
        (request.auth.uid == resource.data.seekerUid || request.auth.uid == resource.data.donorId);
      allow delete: if false;
    }

    // ══════════════════════════════════════════════════════════
    // FEEDBACK
    // ══════════════════════════════════════════════════════════
    match /feedback/{docId} {
      // BUGFIX: আগে লগইন ছাড়াই feedback লেখা যেতো — একটা স্ক্রিপ্ট
      // দিয়ে লক্ষ লক্ষ ডকুমেন্ট লিখে বিল ও quota শেষ করে দেওয়া যেতো।
      allow create: if isLoggedIn()
        && request.resource.data.text is string
        && request.resource.data.text.size() <= 1000
        && request.resource.data.rating is number
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5;
      allow read  : if isAdmin();
      allow update, delete: if false;
    }

    // ══════════════════════════════════════════════════════════
    // SETTINGS
    // ══════════════════════════════════════════════════════════
    match /settings/{docId} {
      allow read  : if true;
      allow write : if isAdmin();
    }

    // ══════════════════════════════════════════════════════════
    // AMBULANCES (পাবলিক ডিরেক্টরি — এখানে phone গোপন রাখার দরকার নেই,
    // এগুলো organization/service নম্বর, ব্যক্তিগত donor নম্বর না)
    // ══════════════════════════════════════════════════════════
    match /ambulances/{docId} {
      allow read  : if true;
      allow create: if isAdmin()
        && request.resource.data.name is string && request.resource.data.name.size() <= 200
        && request.resource.data.phone is string && request.resource.data.phone.size() <= 20;
      allow update, delete: if isAdmin();
    }

    // ══════════════════════════════════════════════════════════
    // BLOOD BANKS — পাবলিক ডিরেক্টরি (ব্লাড ব্যাংক ও স্বেচ্ছাসেবী সংগঠন)
    // এগুলো প্রতিষ্ঠানের নম্বর, ব্যক্তিগত ডোনারের নয় — তাই সবার জন্য
    // খোলা রাখা যায় (লগইন ছাড়াও, কারণ জরুরি অবস্থায় লগইন করতে বলা
    // অযৌক্তিক)। শুধু অ্যাডমিন যোগ/সম্পাদনা করতে পারে, তাই স্প্যাম হবে না।
    // ══════════════════════════════════════════════════════════
    match /bloodBanks/{docId} {
      allow read  : if true;
      allow create: if isAdmin()
        && request.resource.data.name is string && request.resource.data.name.size() <= 200
        && request.resource.data.phone is string && request.resource.data.phone.size() <= 20
        && request.resource.data.address is string && request.resource.data.address.size() <= 300;
      allow update, delete: if isAdmin();
    }

    // ══════════════════════════════════════════════════════════
    // BANK REPORTS — ইউজারের "নম্বর ভুল?" রিপোর্ট
    // লগইন করা ইউজার রিপোর্ট করতে পারে, কিন্তু পড়তে পারে শুধু অ্যাডমিন।
    // (লগইন বাধ্যতামূলক — নাহলে স্ক্রিপ্ট দিয়ে হাজারো ভুয়া রিপোর্ট
    //  লিখে quota ও বিল শেষ করে দেওয়া যেত।)
    // ══════════════════════════════════════════════════════════
    match /bankReports/{docId} {
      allow create: if isLoggedIn()
        && request.resource.data.bankId is string
        && request.resource.data.bankId.size() <= 100;
      allow read  : if isAdmin();
      allow update, delete: if false;
    }

    // ══════════════════════════════════════════════════════════
    // SLIDERS (হোমপেজ ব্যানার)
    // ══════════════════════════════════════════════════════════
    match /sliders/{docId} {
      allow read  : if true;
      allow create: if isAdmin()
        && request.resource.data.text is string && request.resource.data.text.size() <= 300;
      allow update, delete: if isAdmin();
    }
  }
}
